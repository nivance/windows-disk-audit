{
  "schema": 2,
  "updatedAt": "2026-10-11",
  "notes": [
    "clean.ps1 在删除前用本文件做硬校验，三种校验方式：",
    "  exactPaths  - 路径与本列表某项完全相同 -> 拒绝（用于「整个目录本身」这种荒唐目标）",
    "  paths       - 路径等于、或位于本列表某项之下 -> 拒绝（用于保护整个子树）",
    "  depth1Allow - 例外清单：仅当路径直接挂在盘符根下（如 C:\\X）时才允许，其余盘符根下的目录一律拒绝",
    "这些条目不是建议，是硬约束。改动前请确认你清楚后果。"
  ],
  "exactPaths": [
    "%SYSTEMDRIVE%",
    "%WINDIR%",
    "%SYSTEMDRIVE%\\Users",
    "%SYSTEMDRIVE%\\ProgramData",
    "%SYSTEMDRIVE%\\Recovery",
    "%SYSTEMDRIVE%\\System Volume Information",
    "%SYSTEMDRIVE%\\Intel",
    "%SYSTEMDRIVE%\\MyDrivers",
    "%SYSTEMDRIVE%\\PerfLogs",
    "%PROGRAMFILES%",
    "%PROGRAMFILES(X86)%",
    "%PROGRAMDATA%",
    "%USERPROFILE%",
    "%LOCALAPPDATA%",
    "%APPDATA%"
  ],
  "depth1Allow": [
    "%SYSTEMDRIVE%\\$Recycle.Bin",
    "%SYSTEMDRIVE%\\tmp"
  ],
  "paths": [
    "%WINDIR%\\System32",
    "%WINDIR%\\SysWOW64",
    "%WINDIR%\\WinSxS",
    "%WINDIR%\\Fonts",
    "%WINDIR%\\assembly",
    "%WINDIR%\\Microsoft.NET",
    "%WINDIR%\\Installer",
    "%WINDIR%\\servicing",
    "%WINDIR%\\Boot",
    "%WINDIR%\\SystemResources",
    "%WINDIR%\\INF",
    "%WINDIR%\\drivers",
    "%WINDIR%\\SystemApps",
    "%PROGRAMFILES%",
    "%PROGRAMFILES(X86)%",
    "%PROGRAMDATA%\\Microsoft\\Windows Defender",
    "%PROGRAMDATA%\\Microsoft\\Windows Defender Advanced Threat Protection",
    "%SYSTEMDRIVE%\\Recovery",
    "%SYSTEMDRIVE%\\System Volume Information",
    "%USERPROFILE%\\Desktop",
    "%USERPROFILE%\\Documents",
    "%USERPROFILE%\\Pictures",
    "%USERPROFILE%\\Videos",
    "%USERPROFILE%\\Music",
    "%USERPROFILE%\\Downloads",
    "%USERPROFILE%\\OneDrive",
    "%USERPROFILE%\\.ssh",
    "%USERPROFILE%\\.workbuddy\\binaries",
    "%USERPROFILE%\\.workbuddy\\skills",
    "%USERPROFILE%\\.workbuddy\\app",
    "%USERPROFILE%\\.workbuddy\\plugins",
    "%USERPROFILE%\\.workbuddy\\projects",
    "%USERPROFILE%\\.workbuddy\\connectors",
    "%USERPROFILE%\\.workbuddy\\automations"
  ],
  "denyNamePatterns": [
    "System32",
    "SysWOW64",
    "WinSxS",
    "Fonts",
    "assembly",
    "servicing",
    "Program Files",
    "Program Files (x86)",
    "System Volume Information",
    "Windows Defender"
  ],
  "hardRules": [
    "禁止对盘符根目录（如 C:\\）执行任何删除",
    "禁止使用 rm / del / rmdir 等直接抹除命令，一律走回收站",
    "禁止在不列出具体路径的情况下执行批量删除",
    "单批次待删项不得超过 10 个"
  ]
}
